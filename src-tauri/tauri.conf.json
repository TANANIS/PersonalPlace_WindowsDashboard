{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "個人工作台",
  "version": "0.8.0",
  "identifier": "tw.jsrad.personal-workspace",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "個人工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "整理並開啟桌面應用程式與網頁",
    "longDescription": "一款本機優先的 Windows 個人工作台，用來整理並開啟桌面應用程式、網頁與工作內容。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["TradChinese", "English"]
      }
    }
  }
}
