{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal Place",
  "version": "1.7.1",
  "identifier": "tw.jsrad.personal-workspace",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Personal Place",
        "width": 1440,
        "height": 900,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost http://preview.localhost preview: blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "本機優先的 Windows 個人數位首頁",
    "longDescription": "Personal Place 是本機優先的 Windows 個人數位首頁，讓你依照想做的事情整理應用程式、網站、檔案與工具。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "none",
        "displayLanguageSelector": true,
        "languages": ["TradChinese", "English"]
      },
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "D:\\Personal_Place\\app\\scripts\\sign-windows.ps1",
          "%1"
        ]
      }
    }
  }
}
